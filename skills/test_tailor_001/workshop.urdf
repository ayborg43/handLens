<?xml version='1.0' encoding='us-ascii'?>
<robot name="workshop">
  <link name="base">
    <inertial>
      <mass value="1.0" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
  </link>
  <link name="obj_00">
    <visual>
      <geometry>
        <mesh filename="model.glb" />
